# GEMINI_API_KEY: Required for Gemini AI roadmap generation, AI mentor, project generator, and skill assessments.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Optional secret for signing authentication session tokens (falls back to secure runtime secret if unset).
SESSION_SECRET=""

# GOOGLE_CLIENT_ID: Optional Google OAuth Client ID for Google Sign-In.
GOOGLE_CLIENT_ID=""
